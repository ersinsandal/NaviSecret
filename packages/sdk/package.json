{
  "name": "@navisecret/sdk",
  "version": "1.0.0",
  "description": "SDK for NaviSecret privacy-preserving location sharing platform",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:dist": "node ./test/trust-scorer.dist-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "author": "Ersin Sandal (SliferSoft)",
  "keywords": [
    "location",
    "sharing",
    "privacy",
    "supabase",
    "realtime",
    "navisecret"
  ],
  "license": "MIT"
}
