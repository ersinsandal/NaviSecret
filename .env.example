# ==============================================================================
# NaviSecret - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# Generate production-ready keys:
#   node scripts/generate-keys.mjs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Port Bindings
# ------------------------------------------------------------------------------
# Web application frontend port on host machine
WEB_PORT=3000

# Backend API server port on host machine
API_PORT=8000

# Redis Geospatial Cache port on host machine
REDIS_PORT=6379

# PostgreSQL port on host machine (set to 5433 to avoid 5432 conflict)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Public URLs (Domain / Reverse Proxy)
# ------------------------------------------------------------------------------
# Public URL for web frontend
SITE_URL=http://localhost:3000

# Public URL for Backend API & WebSockets
API_EXTERNAL_URL=http://localhost:8000

# Permitted redirect URLs for authentication
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------------------------
# 3. Database & Cache Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me-to-a-secure-database-password-in-production
DATABASE_URL=postgresql://postgres:change-me-to-a-secure-database-password-in-production@localhost:5433/postgres
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Cryptographic Authentication & JWT Secret
# ------------------------------------------------------------------------------
# JWT secret used to sign and verify tokens (minimum 32 characters)
JWT_SECRET=super-secret-jwt-token-navisecret-production-template-32chars

# ------------------------------------------------------------------------------
# 5. Secret Capsule Server-Side Encryption
# ------------------------------------------------------------------------------
# Salt used for serverUnlock key derivation (must be 32+ characters or hex)
CAPSULE_ENCRYPTION_SECRET=change-me-to-a-random-32-byte-hex-string-for-production
